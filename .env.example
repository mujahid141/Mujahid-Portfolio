RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# Optional. Must be a domain you verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=

# Your deployed URL (used for sitemap, social previews, SEO)
NEXT_PUBLIC_SITE_URL=https://yourname.dev
